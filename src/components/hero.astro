---
import { createTranslator, type Locale } from '@/lib/i18n';
interface Props {
  locale?: Locale;
}
const { locale = 'vi' } = Astro.props;
const t = createTranslator(locale);

import { BsSoundwave } from 'react-icons/bs/index';

import { Container } from './container';
import { count as soundCount } from '@/lib/sounds';

const count = soundCount();
---

<section aria-labelledby="hero-title" class="hero">
  <nav aria-label={t('Language')} class="language-switch">
    <a href="/" lang="vi" hreflang="vi" aria-current={locale === 'vi' ? 'page' : undefined}>VI</a>
    <a href="/en/" lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
  </nav>
  <div aria-hidden="true" class="landscape"></div>
  <div aria-hidden="true" class="wash"></div>

  <Container>
    <div class="wrapper">
      <div class="brand">
        <BsSoundwave aria-hidden="true" />
        <span>{t('Focus by ')}<a href="https://www.theworkdocs.com/" target="_blank" rel="noopener noreferrer" aria-label={t('The Work Docs (opens in a new tab)')}>The Work Docs</a></span>
      </div>
      <h1 id="hero-title" class="title">
        {t('A little space')}<br />{t('to find your focus.')}
      </h1>
      <p class="desc">
        {t('Read deeply. Work gently. Take a breath.')}<br />
        {t('Your favorite sounds, together in one calm space.')}
      </p>
      <div class="actions">
        <a class="button" href="#app">{t('Find your sounds')}</a>
        <a class="tools-link" href="https://www.theworkdocs.com/" target="_blank" rel="noopener noreferrer" aria-label={t('Explore The Work Docs (opens in a new tab)')}>{t('Explore The Work Docs')}</a>
      </div>
      <p class="sounds">{t('{count} ambient sounds. Free and open-source.', { count })}</p>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-foreground);
    text-align: center;
    background: var(--color-background);
  }

  .language-switch {
    position: absolute;
    top: 16px;
    right: 20px;
    display: flex;
    gap: 2px;
    padding: 3px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-size: 12px;
  }
  .language-switch a {
    display: grid;
    place-items: center;
    min-width: 36px;
    min-height: 32px;
    color: var(--color-foreground-subtle);
    text-decoration: none;
    border-radius: 100px;
  }
  .language-switch a[aria-current='page'] {
    color: var(--color-accent);
    background: var(--color-selected-surface);
  }
  .language-switch a:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .landscape,
  .wash {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }

  .landscape {
    background-image: image-set(
      url('/images/hero/campus-garden-dusk.avif') type('image/avif'),
      url('/images/hero/campus-garden-dusk.webp') type('image/webp')
    );
    background-size: cover;
    background-position: center 65%;
    mask-image: linear-gradient(#000 66%, transparent 100%);
  }

  .wash {
    background: linear-gradient(
      180deg,
      var(--color-background) 0%,
      color-mix(in srgb, var(--color-background) 72%, transparent) 30%,
      transparent 70%
    );
  }

  .wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 52px 0 210px;
  }

  .brand {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 42px;
    font-size: 20px;
    font-weight: 550;
    letter-spacing: -0.04em;

    & a {
      color: inherit;
      text-decoration: none;

      &:hover {
        color: var(--color-accent);
      }

      &:focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 4px;
        border-radius: 4px;
      }
    }

    & :global(svg) {
      font-size: 28px;
      color: var(--color-accent);
    }
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.5vw, 5.25rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .desc {
    max-width: 480px;
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-foreground-subtle);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 22px;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
  }

  .tools-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 5px;

    &:hover {
      color: var(--color-accent);
      text-decoration-color: currentColor;
    }

    &:focus-visible {
      outline: 2px solid var(--color-focus);
      outline-offset: 4px;
    }
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 24px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-inverted-foreground);
    text-decoration: none;
    background: var(--color-inverted-background);
    border-radius: 999px;

    &:hover {
      background: var(--color-inverted-background-hover);
    }

    &:focus-visible {
      outline: 3px solid var(--color-focus);
      outline-offset: 4px;
    }
  }

  .sounds {
    margin-top: 16px;
    font-size: 13px;
    color: var(--color-foreground-subtle);
  }

  :global(html[data-theme='light']) .landscape {
    background-image: image-set(
      url('/images/hero/campus-garden-day.avif') type('image/avif'),
      url('/images/hero/campus-garden-day.webp') type('image/webp')
    );
  }

  @media (width <= 600px) {
    .wrapper {
      padding: 72px 0 180px;
    }

    .brand {
      margin-bottom: 36px;
      font-size: clamp(16px, 4.5vw, 20px);
    }

    .title {
      font-size: clamp(2.5rem, 9vw, 3.5rem);
    }

    .desc {
      max-width: 320px;
      font-size: 15px;
    }

    .landscape {
      background-image: image-set(
        url('/images/hero/campus-garden-dusk-mobile.avif') type('image/avif'),
        url('/images/hero/campus-garden-dusk.webp') type('image/webp')
      );
      background-position: center bottom;
    }

    :global(html[data-theme='light']) .landscape {
      background-image: image-set(
        url('/images/hero/campus-garden-day-mobile.avif') type('image/avif'),
        url('/images/hero/campus-garden-day.webp') type('image/webp')
      );
    }
  }
</style>
