---
import { pwaInfo } from 'virtual:pwa-info'; // eslint-disable-line
import Analytics from '@vercel/analytics/astro';
import { createTranslator, type Locale } from '@/lib/i18n';

import { Reload } from '@/components/reload';

import { count } from '@/lib/sounds';

import '@/styles/global.css';

interface Props {
  locale?: Locale;
  description?: string;
  title?: string;
}

const { locale = 'vi' } = Astro.props;
const t = createTranslator(locale);
const title =
  Astro.props.title ||
  t('Focus by The Work Docs — Ambient sounds for focus and calm');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(
  locale === 'vi' ? '/og-vi.png?v=vi-1' : '/og.png?v=en-1',
  Astro.site,
);
const imageAlt = t(
  'Focus by The Work Docs — A little space to find your focus, above a peaceful illustrated garden.',
);
const description =
  Astro.props.description ||
  t(
    'Find your focus with The Work Docs. Mix {count} ambient sounds, set a focus timer, and keep your notes close. Free and open-source.',
    { count: count() },
  );
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <meta content={Astro.generator} name="generator" />
    <meta content="#121923" name="theme-color" />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('moodist-theme');
        const preference = ['system', 'light', 'dark'].includes(saved)
          ? saved
          : 'system';
        const theme =
          preference === 'system'
            ? matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : preference;

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', theme === 'dark' ? '#121923' : '#faf9f5');
      })();
    </script>
    <link href="/favicon.svg?v=focus" rel="icon" type="image/svg+xml" />
    <link href="/assets/pwa/192.png?v=focus" rel="apple-touch-icon" />
    <link rel="preload" href="/fonts/SNPro-Latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="vi" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <title>{title}</title>
    <meta content={title} name="title" />
    <meta content={description} name="description" />
    <meta content="Focus by The Work Docs" name="application-name" />
    <meta content="Focus" name="apple-mobile-web-app-title" />
    <meta content="The Work Docs team" name="author" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="Focus by The Work Docs" property="og:site_name" />
    <meta content={canonicalUrl} property="og:url" />
    <meta content="website" property="og:type" />
    <meta content={locale === 'vi' ? 'vi_VN' : 'en_US'} property="og:locale" />
    <meta content={locale === 'vi' ? 'en_US' : 'vi_VN'} property="og:locale:alternate" />
    <meta content={imageUrl} property="og:image" />
    <meta content="image/png" property="og:image:type" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <meta content={imageAlt} property="og:image:alt" />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={imageUrl} name="twitter:image" />
    <meta content={imageAlt} name="twitter:image:alt" />

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body>
    <slot />

    <Reload locale={locale} client:load />
    <Analytics />
  </body>
</html>
